(정의 입력상태 `(
	; keyboard led state
	,(이름표 '입력상태) ; keystatus
	,@(이동_8톨_상수 상위8톨-셈 0육02) ; MOV		AH, 0x02 | B4 02
	,@(인터럽트 0육16) ; INT		0x16 | CD 16
	,@(저장_멤_하위8톨-셈_직접 LED_상태) ; MOV 	[LEDS], AL | A2 F1 0F

; PIC don't receive any interrupt
	,@(이동_8톨_상수 하위8톨-셈 0육ㅂㅂ); MOV		AL,	0xff | B0 FF 
	,@(출력_상수_하위8톨-셈 0육21) ; OUT		0x21, AL | E6 21
	,노옵 ; NOP | 90
	,@(출력_상수_하위8톨-셈 0육ㄱ1) ; OUT		0xa1, AL | E6 A1

	,인터럽트_끄기 ; CLI | FA

; set A20GATE to allow the CPU to access more than 1MB of Memory
	,(호출_이름표 '키보드기다려) ; CALL	waitkbdout | E8 B5 00
	,@(이동_8톨_상수 하위8톨-셈 0육ㄹ1) ; MOV		AL,	0xd1 | B0 D1
	,@(출력_상수_하위8톨-셈 0육64) ; OUT		0x64, AL | E6 64
	,(호출_이름표 '키보드기다려) ; CALL	waitkbdout | E8 AE 00
	,@(이동_8톨_상수 하위8톨-셈 0육ㄹㅂ) ; MOV		AL, 0xdf | B0 DF
	,@(출력_상수_하위8톨-셈 0육60) ; OUT		0x60, AL | E6 60
	,(호출_이름표 '키보드기다려) ; CALL	waitkbdout | E8 A7 00

	,@(불러_지디티_이름표 '지디티알0) ; LGDT	[GDTR0] | 0F 01 16 8A C3
	,@(이동_레지_제어 셈 제어0) ; MOV		EAX, CR0 | 0F 20 C0
	,@(비트곱_32톨_셈_상수 0육7ㅂㅂㅂㅂㅂㅂㅂ) ; AND		EAX, 0x7fffffff | 66 25 FF FF FF 7F
	,@(32톨_접두사
		(비트합_32톨_레지_상수8 셈 0육00000001)) ; OR		EAX, 0x00000001 | 기존 함수를 사용하면 66 0D 01 00 00 00 가 맞는데, NASK에서 1이 최적화 되어 66 83 C8 01로 나옴
	,@(이동_제어_레지 제어0 셈) ; MOV		CR0, EAX | 0F 22 C0
	,(뛰기_이름표 '파이프라인_플러시) ; JMP		pipelineflush | EB 00
))

(정의 파이프라인_플러시 `(
	,(이름표 '파이프라인_플러시) ; pipelineflush
	,@(이동_16톨_상수 셈 (2바이트 (* 1 8))) ; MOV		AX, 1*8 | B8 08 00
	,@(이동_레지_세그 (주소_레지 자료판 셈)) ; MOV		DS, AX | 8E D8
	,@(이동_레지_세그 (주소_레지 여분판 셈)) ; MOV		ES, AX | 8E C0
	,@(이동_레지_세그 (주소_레지 추가판1 셈)) ; MOV		FS, AX | 8E E0
	,@(이동_레지_세그 (주소_레지 추가판2 셈)) ; MOV 	GS, AX | 8E E8
	,@(이동_레지_세그 (주소_레지 쌓음판 셈)) ; MOV		SS, AX | 8E D0

	; send bootpack
	,@(32톨_접두사
		(이동_32톨_이름표 출처 (리스트 (4톨_이름표_주소 '부트팩)))) ; MOV		ESI, bootpack | 66 BE 90 C3 00 00
	,@(32톨_접두사
		(이동_32톨_상수 도착 부트_포장)) ; MOV		EDI, BOTPAK | 66 BF 00 00 28 00
	,@(32톨_접두사
		(이동_32톨_상수 횟수 (/ (* 512 1024) 4))) ; MOV		ECX, 512*1024/4 | 66 B9 00 00 02 00
	,(호출_이름표 '멤_복사) ; CALL	memcpy | E8 75 00

	; send disk data
	; boot sector
	,@(32톨_접두사
		(이동_32톨_상수 출처 0육7ㄷ00)) ; MOV		ESI, 0x7c00 | 66 BE 00 7C 00 00
	,@(32톨_접두사
		(이동_32톨_상수 도착 원반_캐시)) ; MOV		EDI, DSKCAC | 66 BF 00 00 10 00
	,@(32톨_접두사
		(이동_32톨_상수 횟수 (/ 512 4))) ; MOV		ECX, 512/4 | 66 B9 80 00 00 00
	,(호출_이름표 '멤_복사) ; CALL	memcpy | E8 60 00
	; remain
	,@(32톨_접두사
		(이동_32톨_상수 출처 (+ 원반_캐시0 512))) ; MOV		ESI, DSKCAC0+512 | 66 BE 00 82 00 00
	,@(32톨_접두사
		(이동_32톨_상수 도착 (+ 원반_캐시 512))) ; MOV		EDI, DSKCAC+512 | 66 BF 00 02 10 00
	,@(32톨_접두사
		(이동_32톨_상수 횟수 0)) ; MOV		ECX, 0 | 66 B9 00 00 00 00
	,@(이동_8톨_레지_멤 하위8톨-횟수 실린더) ; MOV		CL, BYTE [CYLS] | 8A 0E F0 0F
	,@(32톨_접두사
		(곱하기_32톨_상수 횟수 (/ (* (* 512 18) 2) 4))) ; IMUL	ECX, 512*18*2/4 | 66 69 C9 00 12 00 00
	,@(32톨_접두사
		(빼기_32톨_상수 횟수 (/ 512 4))) ; SUB		ECX, 512/4 | 66 81 E9 80 00 00 00
	,(호출_이름표 '멤_복사) ; CALL	memcpy | E8 39 00

	; bootpack
	,@(32톨_접두사
		(이동_32톨_상수 기준 부트_포장)) ; MOV		EBX, BOTPAK | 66 BB 00 00 28 00
	,@(주소_접두사
		(32톨_접두사
			(이동_32톨_레지_멤_8 횟수 기준 16))) ; MOV		ECX, [EBX+16] | 67 66 8B 4B 10
	,@(32톨_접두사
		(더하기_16톨_레지_상수 횟수 3)) ; ADD		ECX, 3 | 66 83 C1 03
	,@(32톨_접두사
		(비트이동_오른쪽 횟수 2)) ; SHR		ECX, 2 | 66 C1 E9 02
	,(뛰기_동일 '생략) ; JZ		skip | 74 10
	,@(주소_접두사
		(32톨_접두사
			(이동_32톨_레지_멤_8 출처 기준 20))) ; MOV		ESI, [EBX+20] | 67 66 8B 73 14 
	,@(32톨_접두사
		(더하기_16톨_레지_레지 출처 기준)) ; ADD		ESI, EBX | 66 01 DE
	,@(주소_접두사
		(32톨_접두사
			(이동_32톨_레지_멤_8 도착 기준 12))) ; MOV		EDI, [EBX+12] | 67 66 8B 7A 0C
	,(호출_이름표 '멤_복사) ; CALL	memcpy | EB 14 00
))

