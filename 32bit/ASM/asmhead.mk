(정의 헤더 `(
	,(이름표 '헤더) ; header
; Check VBE
	,@(이동_16톨_상수 셈 (2바이트 0육9000)) ; MOV 	AX, 0x9000 | B8 00 90
	,@(이동_레지_세그 (주소_레지 여분판 셈)) ; MOV 	ES, AX | 8E C0
	,@(이동_16톨_상수 도착 (2바이트 0)) ; MOV 	DI, 0 | BF 00 00
	,@(이동_16톨_상수 셈 (2바이트 0육4f00)) ; MOV 	AX, 0x4f00 | B8 00 4F
	,@(인터럽트 0육10) ; INT 	0x10 | CD 10
	,@(비교_셈_상수16 0육004ㅂ) ; CMP 	AX, 0x004f | 3D 4F 00
	,(뛰기_다름 '화면320) ; JNE 	scrn320 | 75 52
; VBE version check
	,@(여분판_접두사
		(이동_16톨_레지 (주소_메모리_8 셈 ㅁ+도착 0육04))) ; MOV 	AX, [ES:DI+4] | 26 8B 45 04
	,@(비교_셈_상수16 0육0200) ; CMP 	AX, 0x0200 | 3D 00 02
	,(뛰기_미만 '화면320) ; JB  	scrn320 | 72 49
; get screen mode info
	,@(이동_16톨_상수 횟수 (2바이트 영상_유형)) ; MOV 	CX, VBEMODE | B9 05 01
	,@(이동_16톨_상수 셈 (2바이트 0육4f01)) ; MOV 	AX, 0x4f01 | B8 01 4F
	,@(인터럽트 0육10) ; INT 	0x10 | CD 10 | CD 10
	,@(비교_셈_상수16 0육004ㅂ) ; CMP 	AX, 0x004f | 3D 4F 00
	,(뛰기_다름 '화면320) ; JNE 	scrn320 | 75 3C
; check screen mode info
	,@(여분판_접두사 
		(비교_멤_8톨_상수 (주소_메모리_8 _비교 ㅁ+도착 0육19) 8)) ; CMP 	BYTE [ES:DI+0x19], 8 | 26 80 7D 19 08
	,(뛰기_다름 '화면320) ; JNE		scrn320 | 75 35
	,@(여분판_접두사 
		(비교_멤_8톨_상수 (주소_메모리_8 _비교 ㅁ+도착 0육1ㄴ) 4)) ; CMP 	BYTE [ES:DI+0x1b], 4 | 26 80 7D 1B 04
	,(뛰기_다름 '화면320) ; JNE		scrn320 | 75 2E
	,@(여분판_접두사 
	(이동_16톨_레지 (주소_메모리 셈 ㅁ+도착))) ; MOV 	AX, [ES:DI+0x00] | 26 8B 05 -> 원래는 26 8B 45 00이지만, NASK에서 0x00이 0으로 최적화되어서 26 8B 05로 나옴
	,@(저장_16톨_멤_셈 0육0080) ; AND 	AX, 0x0080 | 25 80 00
	,(뛰기_동일 '화면320) ; JZ  	scrn320 | 74 26

; change screen mode
	,@(이동_16톨_상수 기준 (2바이트 (+ 영상_유형 0육4000))) ; MOV 	BX, VBEMODE+0x4000
	,@(이동_16톨_상수 셈 (2바이트 0육4f02)) ; MOV 	AX, 0x4f02
	,@(인터럽트 0육10) ; INT 	0x10 | CD 10
	,@(이동_멤_8톨_상수 영상_모드 8) ; MOV 	BYTE [VMODE] | C6 05 F2 FF 08
	,@(여분판_접두사
		(이동_16톨_레지 (주소_메모리_8 0 ㅁ+도착 0육12))) ; MOV		AX, [ES:DI+0x12] | 26 8B 45 12
	,@(저장_멤_셈_직접 화면_너비) ; MOV 	[SCRNX], AX | A3 F4 0F 26
	,@(여분판_접두사
		(이동_16톨_레지 (주소_메모리_8 0 ㅁ+도착 0육14))) ; MOV		AX, [ES:DI+0x14] | 8B 45 14
	,@(저장_멤_셈_직접 화면_높이) ; MOV 	[SCRNY], AX | A3 F6 0F 66
	,@(32톨_접두사
		(여분판_접두사
			(이동_16톨_레지 (주소_메모리_8 셈 ㅁ+도착 0육28)))) ; MOV 	EAX, [ES:DI+0x28] | 26 8B 45 28
	,@(32톨_접두사
		(저장_멤_셈_직접 비디오_램)) ; MOV 	[VRAM], EAX | 66 A3 F8 0F
	,(뛰기_이름표 '입력상태); JMP 	keystatus | EB 20
))

(정의 화면320 `(
	,(이름표 '화면320) ; scrn320
	,@(이동_8톨_상수 하위8톨-셈 0육13) ; MOV		AL, 0x13 | B0 13
	,@(이동_8톨_상수 상위8톨-셈 0육00) ; MOV		AH, 0x00 | B4 00
