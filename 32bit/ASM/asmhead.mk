	,@(이동_멤_8톨_상수 영상_모드 8) ; MOV 	BYTE [VMODE], 8 | C6 06 F2 0F 08
	,@(이동_멤_16톨_상수 화면_너비 320) ; MOV		WORD [SCRNX], 320 | C7 06 F4 0F 40 01
